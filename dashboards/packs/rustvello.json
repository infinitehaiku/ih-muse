{
  "id": "otel.rustvello",
  "revision": 2,
  "title": "Rustvello",
  "description": "Rustvello tasks from its OTLP lifecycle export: throughput and failures as Rustvello counts them; tasks by state, run-time percentiles, busy time, retries and worker starts as Poet counts them from the lifecycle records.",
  "muse_kind": "otel",
  "applies_to": {
    "recognition": {
      "root_attributes": [
        {
          "key": "rustvello.app.id"
        }
      ],
      "scope_names": [
        "rustvello.lifecycle"
      ],
      "metric_prefixes": [
        "rustvello."
      ],
      "min_metrics": 1
    }
  },
  "panels": [
    {
      "id": "throughput",
      "title": "Completed tasks",
      "metric": "rustvello.task.completed",
      "aggregation": "rate",
      "signal": "traffic"
    },
    {
      "id": "failures",
      "title": "Failed tasks",
      "metric": "rustvello.task.completed",
      "aggregation": "rate",
      "signal": "errors",
      "filters": [
        {
          "key": "outcome",
          "op": "eq",
          "value": "failed"
        }
      ]
    },
    {
      "id": "run_time_p95",
      "title": "Run time p95",
      "metric": "rustvello.task.duration",
      "aggregation": "p95",
      "signal": "latency"
    },
    {
      "id": "busy",
      "title": "Busy workers",
      "metric": "rustvello.task.busy_time",
      "aggregation": "rate",
      "signal": "saturation"
    },
    {
      "id": "tasks_by_state",
      "title": "Tasks by state",
      "metric": "rustvello.task.events",
      "aggregation": "rate",
      "group_by": {
        "attribute": "rustvello.event"
      },
      "top_n": 8
    },
    {
      "id": "submitted",
      "title": "Submitted tasks",
      "metric": "rustvello.task.events",
      "aggregation": "rate",
      "filters": [
        {
          "key": "rustvello.event",
          "op": "eq",
          "value": "task.submitted"
        }
      ]
    },
    {
      "id": "run_time_p50",
      "title": "Run time p50",
      "metric": "rustvello.task.duration",
      "aggregation": "p50"
    },
    {
      "id": "run_time_p99",
      "title": "Run time p99",
      "metric": "rustvello.task.duration",
      "aggregation": "p99"
    },
    {
      "id": "latency_p95_by_task",
      "title": "Run time p95 by task",
      "metric": "rustvello.task.duration",
      "aggregation": "p95",
      "group_by": {
        "attribute": "rustvello.task.id"
      },
      "top_n": 8
    },
    {
      "id": "busy_by_task",
      "title": "Time by task",
      "metric": "rustvello.task.busy_time",
      "aggregation": "rate",
      "group_by": {
        "attribute": "rustvello.task.id"
      },
      "top_n": 8
    },
    {
      "id": "throughput_by_task",
      "title": "Completed by task",
      "metric": "rustvello.task.completed",
      "aggregation": "rate",
      "group_by": {
        "attribute": "rustvello.task.id"
      },
      "top_n": 8
    },
    {
      "id": "failures_by_task",
      "title": "Failures by task",
      "metric": "rustvello.task.completed",
      "aggregation": "rate",
      "filters": [
        {
          "key": "outcome",
          "op": "eq",
          "value": "failed"
        }
      ],
      "group_by": {
        "attribute": "rustvello.task.id"
      },
      "top_n": 8
    },
    {
      "id": "retries",
      "title": "Retries by task",
      "metric": "rustvello.task.events",
      "aggregation": "rate",
      "filters": [
        {
          "key": "rustvello.event",
          "op": "eq",
          "value": "task.retry_scheduled"
        }
      ],
      "group_by": {
        "attribute": "rustvello.task.id"
      },
      "top_n": 8
    },
    {
      "id": "failures_by_error",
      "title": "Failures by error type",
      "metric": "rustvello.task.duration",
      "aggregation": "count_rate",
      "filters": [
        {
          "key": "outcome",
          "op": "eq",
          "value": "failed"
        }
      ],
      "group_by": {
        "attribute": "rustvello.error.type"
      },
      "top_n": 8
    },
    {
      "id": "throughput_by_queue",
      "title": "Completed by queue",
      "metric": "rustvello.task.completed",
      "aggregation": "rate",
      "group_by": {
        "attribute": "rustvello.queue"
      },
      "top_n": 8
    },
    {
      "id": "worker_events",
      "title": "Worker starts and stops",
      "metric": "rustvello.worker.events",
      "aggregation": "rate",
      "group_by": {
        "attribute": "rustvello.event"
      },
      "top_n": 4
    }
  ],
  "blocks": [
    {
      "label": "Tasks",
      "panels": [
        "tasks_by_state",
        "submitted",
        "throughput_by_queue"
      ]
    },
    {
      "label": "Run time",
      "panels": [
        "run_time_p50",
        "run_time_p99",
        "latency_p95_by_task"
      ]
    },
    {
      "label": "Top tasks",
      "panels": [
        "busy_by_task",
        "throughput_by_task",
        "failures_by_task"
      ]
    },
    {
      "label": "Failures and retries",
      "panels": [
        "retries",
        "failures_by_error"
      ]
    },
    {
      "label": "Workers",
      "panels": [
        "worker_events"
      ]
    }
  ],
  "columns": 3
}
